{
  "name": "meltwater-cia-redaction",
  "version": "1.0.0",
  "description": "Technical exercise for redacting and unredacting classified documents.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "demo": "npm run build && node dist/cli/demo.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
